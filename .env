# ===================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT CONFIGURATION)
# Đồ án: Ứng dụng Điểm danh Sinh viên
# Nhóm 2 - Đại học HUTECH
# ===================================================================

# 1. URL API Backend kết nối qua Cloudflare Tunnel (Cho thiết bị di động thật)
API_BASE_URL=https://noble-courage-rear-lit.trycloudflare.com

# 2. URL API Localhost (Khi chạy kiểm thử trên máy tính hoặc Android Emulator)
API_LOCAL_URL=http://localhost:5145

# 3. Thông số kiểm soát điểm danh & vị trí GPS
DEFAULT_RADIUS_METERS=250
HUTECH_LATITUDE=10.7682754
HUTECH_LONGITUDE=106.6025222

# 4. Thông tin ứng dụng
APP_NAME=AppDiemDanhSinhVien
APP_VERSION=1.0.0
